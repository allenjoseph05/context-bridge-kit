{
  "name": "context-bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "tsc -b tsconfig.build.json && pnpm --filter @cb/extension build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @cb/extension typecheck",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "eval": "node -e \"console.log('not yet implemented (T21)')\"",
    "gen:key": "tsx scripts/gen-extension-key.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "~3.2.7"
  }
}

{
  "manifest_version": 3,
  "name": "Context Bridge",
  "version": "0.1.0",
  "description": "Move selected AI chat context between assistants, locally and with your approval.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "nativeMessaging",
    "clipboardWrite",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Context Bridge"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "evals/**/*.ts",
    "vitest.workspace.ts",
    "vitest.config.ts",
    "vitest.shared.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "packages/extension"
  ]
}
